{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information, settings, and membership details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "displayName": { "type": "string", "description": "User's display name." },
        "photoURL": { "type": "string", "format": "uri", "description": "URL to the user's profile picture." },
        "location": { "type": "string", "description": "User's general location." },
        "address": { "type": "string", "description": "User's physical address." },
        "membershipTier": { 
          "type": "string", 
          "enum": ["free", "standard", "pro", "ultimate"],
          "description": "The user's current subscription level."
        },
        "usage": {
          "type": "object",
          "properties": {
            "queriesCount": { "type": "number", "description": "Total number of queries performed." },
            "missionsCount": { "type": "number", "description": "Total number of missions performed." },
            "lastReset": { "type": "string", "format": "date-time", "description": "Last time the usage counters were reset." }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "membershipTier"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profile documents."
    }
  }
}
